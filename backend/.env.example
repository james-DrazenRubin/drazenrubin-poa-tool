# ============================================================================
# Drazen Rubin Law — POA Tool Backend Configuration
# Copy this file to ".env" and adjust as needed. Never commit ".env".
# ============================================================================

# Port the API listens on.
PORT=4000

# Comma-separated list of origins allowed to call the API (CORS).
# Leave blank to allow all (fine for a closed internal network).
# Example: http://localhost:4000,http://10.0.0.5:4000
ALLOWED_ORIGINS=

# Serve the frontend (../frontend) directly from this backend?
# true  = one process serves the form UI and the API (open http://localhost:4000/)
# false = you host the frontend elsewhere and only call the API
SERVE_FRONTEND=true

# ── Anthropic API (checklist parsing) ────────────────────────────────────────
# Required for POST /api/parse-checklist (PDF intake checklist → prefill).
ANTHROPIC_API_KEY=

# ── Practice Panther integration (optional) ───────────────────────────────────
# Enables client/agent lookup in the form. Leave blank to disable.
PP_CLIENT_ID=
PP_CLIENT_SECRET=
PP_REDIRECT_URI=https://slighted-preformed-patriot.ngrok-free.app/api/pp-callback
